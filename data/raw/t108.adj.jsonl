{"id": "t108-038", "text": "Ilse's husband Mateo has just been offered a job in Munich, starts 1 February 2027. She hasn't decided if she's going. Bit torn about it.", "spans": [{"id": "p1", "type": "PERSON", "text": "Ilse", "pronoun": "she"}, {"id": "f1", "type": "FACT", "text": "husband", "owner": "p2", "fact_type": "relationship"}, {"id": "p2", "type": "PERSON", "text": "Mateo", "owner": "p1", "pronoun": "unknown"}, {"id": "e1", "type": "EVENT", "text": "offered a job in Munich", "owner": "p2", "event_type": "job", "followup": "congratulate"}, {"id": "e2", "type": "EVENT", "text": "starts", "owner": "p2", "event_type": "job", "followup": "ask_outcome"}, {"id": "d1", "type": "DATE", "text": "1 February 2027", "anchor": "e2"}, {"id": "f2", "type": "FACT", "text": "Bit torn", "owner": "p1", "fact_type": "feeling"}]}
