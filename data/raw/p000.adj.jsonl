{"id": "p000-030", "text": "long call w/ my sister phoebe. dad's cataract op got moved to tues 12th, she's taking him in and I'm doing the follow up appt the week after. he's grumpy cos no gardening allowed lol. her partner starts a new job monday too and her youngest has a hospital appt for her asthma on weds", "spans": [{"id": "f1", "type": "FACT", "text": "sister", "owner": "p1", "fact_type": "relationship"}, {"id": "p1", "type": "PERSON", "text": "phoebe", "pronoun": "she"}, {"id": "r1", "type": "RELATION", "text": "dad"}, {"id": "e1", "type": "EVENT", "text": "cataract op", "owner": "r1", "event_type": "medical", "followup": "check_in"}, {"id": "d1", "type": "DATE", "text": "tues 12th", "anchor": "e1"}, {"id": "e2", "type": "EVENT", "text": "follow up appt", "owner": "r1", "event_type": "medical", "followup": "none"}, {"id": "d2", "type": "DATE", "text": "the week after", "anchor": "e2"}, {"id": "f2", "type": "FACT", "text": "grumpy", "owner": "r1", "fact_type": "feeling"}, {"id": "i1", "type": "INTEREST", "text": "gardening", "owner": "r1"}, {"id": "r2", "type": "RELATION", "text": "partner", "owner": "p1"}, {"id": "e3", "type": "EVENT", "text": "new job", "owner": "r2", "event_type": "job", "followup": "ask_outcome"}, {"id": "d3", "type": "DATE", "text": "monday", "anchor": "e3"}, {"id": "r3", "type": "RELATION", "text": "youngest", "owner": "p1"}, {"id": "e4", "type": "EVENT", "text": "hospital appt", "owner": "r3", "event_type": "medical", "followup": "check_in"}, {"id": "f3", "type": "FACT", "text": "asthma", "owner": "r3", "fact_type": "health"}, {"id": "d4", "type": "DATE", "text": "weds", "anchor": "e4"}]}
