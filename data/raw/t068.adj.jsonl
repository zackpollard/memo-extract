{"id": "t068-051", "text": "ximena mentioned her niece's christening is end of may in mexico city, she's godmother!! flying out for 2 wks around the 20th. her sister Rosa had the baby back in jan, ximena's only met her on facetime so far. she's nervous abt the speech bit in church, her spanish is rusty apparently lol. asked if i'd water her plants. said fine", "spans": [{"id": "p1", "type": "PERSON", "text": "ximena", "pronoun": "she"}, {"id": "r1", "type": "RELATION", "text": "niece", "owner": "p1"}, {"id": "e1", "type": "EVENT", "text": "christening", "owner": "r1", "event_type": "baby", "followup": "congratulate"}, {"id": "d1", "type": "DATE", "text": "end of may", "anchor": "e1"}, {"id": "f1", "type": "FACT", "text": "godmother", "owner": "p1", "fact_type": "relationship"}, {"id": "e2", "type": "EVENT", "text": "flying out", "owner": "p1", "event_type": "travel", "followup": "ask_outcome"}, {"id": "d2", "type": "DATE", "text": "2 wks", "anchor": "e2"}, {"id": "d3", "type": "DATE", "text": "around the 20th", "anchor": "e2"}, {"id": "f2", "type": "FACT", "text": "sister", "owner": "p2", "fact_type": "relationship"}, {"id": "p2", "type": "PERSON", "text": "Rosa", "owner": "p1", "pronoun": "unknown"}, {"id": "e3", "type": "EVENT", "text": "baby", "owner": "p2", "event_type": "baby", "followup": "congratulate"}, {"id": "d4", "type": "DATE", "text": "back in jan", "anchor": "e3"}, {"id": "p3", "type": "PERSON", "text": "ximena", "pronoun": "she"}, {"id": "f3", "type": "FACT", "text": "nervous", "owner": "p1", "fact_type": "feeling"}, {"id": "e4", "type": "EVENT", "text": "speech bit in church", "owner": "p1", "event_type": "performance", "followup": "wish_luck"}, {"id": "f4", "type": "FACT", "text": "spanish is rusty", "owner": "p1", "fact_type": "other"}]}
