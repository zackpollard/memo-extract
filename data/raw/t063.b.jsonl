{"id": "t063-013", "text": "Khadija graduated from her nursing degree yesterday. Her whole family came over from Leeds for it.", "spans": [{"id": "p1", "type": "PERSON", "text": "Khadija", "pronoun": "she"}, {"id": "e1", "type": "EVENT", "text": "graduated from her nursing degree", "owner": "p1", "event_type": "school", "followup": "congratulate"}, {"id": "d1", "type": "DATE", "text": "yesterday", "anchor": "e1"}, {"id": "r1", "type": "RELATION", "text": "family", "owner": "p1"}]}
