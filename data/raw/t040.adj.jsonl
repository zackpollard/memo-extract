{"id": "t040-040", "text": "sinead mentioned her partner claire has a job interview in dublin on the 9th at 10am. if she gets it they'd move over in the spring. sinead's not sure how she feels about it, her whole family is here and her mum's not well. they're going over the night before to look at areas. didnt push it", "spans": [{"id": "p1", "type": "PERSON", "text": "sinead", "pronoun": "she"}, {"id": "f1", "type": "FACT", "text": "partner", "owner": "p2", "fact_type": "relationship"}, {"id": "p2", "type": "PERSON", "text": "claire", "pronoun": "she", "owner": "p1"}, {"id": "e1", "type": "EVENT", "text": "job interview in dublin", "owner": "p2", "event_type": "interview", "followup": "ask_outcome"}, {"id": "d1", "type": "DATE", "text": "the 9th at 10am", "anchor": "e1"}, {"id": "e2", "type": "EVENT", "text": "move over", "owner": "p1", "event_type": "move", "followup": "ask_outcome"}, {"id": "d2", "type": "DATE", "text": "in the spring", "anchor": "e2"}, {"id": "p3", "type": "PERSON", "text": "sinead", "pronoun": "she"}, {"id": "f2", "type": "FACT", "text": "not sure how she feels about it", "owner": "p1", "fact_type": "feeling"}, {"id": "r1", "type": "RELATION", "text": "family", "owner": "p1"}, {"id": "r2", "type": "RELATION", "text": "mum", "owner": "p1"}, {"id": "f3", "type": "FACT", "text": "not well", "owner": "r2", "fact_type": "health"}, {"id": "e3", "type": "EVENT", "text": "going over", "owner": "p1", "event_type": "travel", "followup": "ask_outcome"}, {"id": "d3", "type": "DATE", "text": "the night before", "anchor": "e3"}]}
