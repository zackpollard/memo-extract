{"id": "x008-048", "text": "Graham's cataract op is on the 9th. His daughter Shira is driving him and staying the night after. Remind me to ring Graham the day after to see how it went, and ask Shira if she needs anything.", "spans": [{"id": "p1", "type": "PERSON", "text": "Graham", "pronoun": "he"}, {"id": "e1", "type": "EVENT", "text": "cataract op", "event_type": "medical", "followup": "check_in", "owner": "p1"}, {"id": "d1", "type": "DATE", "text": "the 9th", "anchor": "e1"}, {"id": "f1", "type": "FACT", "text": "daughter", "fact_type": "relationship", "owner": "p2"}, {"id": "p2", "type": "PERSON", "text": "Shira", "pronoun": "she", "owner": "p1"}, {"id": "d2", "type": "DATE", "text": "the night after"}, {"id": "a1", "type": "ACTION", "text": "ring Graham", "action_type": "ask_outcome", "timing": "after", "owner": "p1", "anchor": "e1"}, {"id": "p3", "type": "PERSON", "text": "Graham", "pronoun": "he"}, {"id": "d3", "type": "DATE", "text": "the day after", "anchor": "a1"}, {"id": "a2", "type": "ACTION", "text": "ask Shira if she needs anything", "action_type": "check_in", "timing": "after", "owner": "p2", "anchor": "e1"}, {"id": "p4", "type": "PERSON", "text": "Shira", "pronoun": "she", "owner": "p1"}]}
