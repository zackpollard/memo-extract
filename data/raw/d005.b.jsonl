{"id": "d005-030", "text": "Felix said his mum has started chemo and the first round went better than expected. Next one is in three weeks. He's holding up, but only just.", "spans": [{"id": "p1", "type": "PERSON", "text": "Felix", "pronoun": "he"}, {"id": "r1", "type": "RELATION", "text": "mum", "owner": "p1"}, {"id": "e1", "type": "EVENT", "text": "chemo", "event_type": "medical", "followup": "check_in", "owner": "r1"}, {"id": "d1", "type": "DATE", "text": "in three weeks", "anchor": "e1"}, {"id": "f1", "type": "FACT", "text": "holding up, but only just", "fact_type": "feeling", "owner": "p1"}]}
