{"id": "t097-047", "text": "Bruno update!!! Figaro came home on his own after 9 days. thin but fine. Bruno is over the moon. Send him a congrats-type message, he'd appreciate it", "spans": [{"id": "p1", "type": "PERSON", "text": "Bruno", "pronoun": "he"}, {"id": "f1", "type": "FACT", "text": "Figaro", "owner": "p1", "fact_type": "pet"}, {"id": "e1", "type": "EVENT", "text": "came home", "owner": "p1", "event_type": "other", "followup": "congratulate"}, {"id": "d1", "type": "DATE", "text": "after 9 days", "anchor": "e1"}, {"id": "p2", "type": "PERSON", "text": "Bruno", "pronoun": "he"}, {"id": "f2", "type": "FACT", "text": "over the moon", "owner": "p1", "fact_type": "feeling"}, {"id": "a1", "type": "ACTION", "text": "Send him a congrats-type message", "owner": "p1", "anchor": "e1", "action_type": "congratulate", "timing": "after"}]}
