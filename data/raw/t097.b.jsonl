{"id": "t097-001", "text": "Hugo's picking up the new puppy on Saturday, a cocker spaniel called Biscuit. Remind me to drop round a chew toy sometime next week", "spans": [{"id": "p1", "type": "PERSON", "text": "Hugo", "pronoun": "unknown"}, {"id": "e1", "type": "EVENT", "text": "new puppy", "owner": "p1", "event_type": "other", "followup": "ask_outcome"}, {"id": "d1", "type": "DATE", "text": "Saturday", "anchor": "e1"}, {"id": "f1", "type": "FACT", "text": "cocker spaniel called Biscuit", "owner": "p1", "fact_type": "pet"}, {"id": "a1", "type": "ACTION", "text": "drop round a chew toy", "owner": "p1", "anchor": "e1", "action_type": "gift", "timing": "after"}, {"id": "d2", "type": "DATE", "text": "sometime next week", "anchor": "a1"}]}
