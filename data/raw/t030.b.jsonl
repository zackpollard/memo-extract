{"id": "t030-001", "text": "Jen's knee op is 14 May at the Royal. She's dreading the anaesthetic more than the surgery. Remind me to text her the night before.", "spans": [{"id": "p1", "type": "PERSON", "text": "Jen", "pronoun": "she"}, {"id": "e1", "type": "EVENT", "text": "knee op", "owner": "p1", "event_type": "medical", "followup": "check_in"}, {"id": "d1", "type": "DATE", "text": "14 May", "anchor": "e1"}, {"id": "f1", "type": "FACT", "text": "dreading the anaesthetic", "owner": "p1", "fact_type": "feeling"}, {"id": "a1", "type": "ACTION", "text": "text her", "owner": "p1", "anchor": "e1", "action_type": "message", "timing": "before"}, {"id": "d2", "type": "DATE", "text": "the night before", "anchor": "a1"}]}
