{"id": "t093-016", "text": "Remind me to ask Ryan how the appeal went. He had the hearing on Wednesday.", "spans": [{"id": "a1", "type": "ACTION", "text": "ask Ryan how the appeal went", "owner": "p1", "anchor": "e2", "action_type": "ask_outcome", "timing": "after"}, {"id": "p1", "type": "PERSON", "text": "Ryan", "pronoun": "he"}, {"id": "e1", "type": "EVENT", "text": "appeal", "owner": "p1", "event_type": "other", "followup": "ask_outcome"}, {"id": "e2", "type": "EVENT", "text": "hearing", "owner": "p1", "event_type": "other", "followup": "ask_outcome"}, {"id": "d1", "type": "DATE", "text": "Wednesday", "anchor": "e2"}]}
