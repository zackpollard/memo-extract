{"id": "t058-056", "text": "chioma's twins turn 5 on 30 Nov, party at soft play the sunday after, 1st Dec. Esme wants anything Frozen, Connor is into dinosaurs, esp the big T rex ones. chioma said not to bring anything big as their flat is tiny. her husband Delroy is back from Lagos the friday b4 so he'll be there", "spans": [{"id": "p1", "type": "PERSON", "text": "chioma", "pronoun": "she"}, {"id": "f1", "type": "FACT", "text": "twins", "owner": "p1", "fact_type": "relationship"}, {"id": "e1", "type": "EVENT", "text": "turn 5", "owner": "p2", "event_type": "birthday", "followup": "gift"}, {"id": "d1", "type": "DATE", "text": "30 Nov", "anchor": "e1"}, {"id": "e2", "type": "EVENT", "text": "party", "owner": "p2", "event_type": "party", "followup": "none"}, {"id": "d2", "type": "DATE", "text": "the sunday after, 1st Dec", "anchor": "e2"}, {"id": "p2", "type": "PERSON", "text": "Esme", "owner": "p1", "pronoun": "unknown"}, {"id": "f2", "type": "FACT", "text": "wants anything Frozen", "owner": "p2", "fact_type": "other"}, {"id": "p3", "type": "PERSON", "text": "Connor", "owner": "p1", "pronoun": "unknown"}, {"id": "i1", "type": "INTEREST", "text": "dinosaurs", "owner": "p3"}, {"id": "i2", "type": "INTEREST", "text": "big T rex ones", "owner": "p3"}, {"id": "p4", "type": "PERSON", "text": "chioma", "pronoun": "she"}, {"id": "f3", "type": "FACT", "text": "flat is tiny", "owner": "p1", "fact_type": "home"}, {"id": "f4", "type": "FACT", "text": "husband", "owner": "p5", "fact_type": "relationship"}, {"id": "p5", "type": "PERSON", "text": "Delroy", "owner": "p1", "pronoun": "he"}, {"id": "e3", "type": "EVENT", "text": "back from Lagos", "owner": "p5", "event_type": "travel", "followup": "ask_outcome"}, {"id": "d3", "type": "DATE", "text": "the friday b4", "anchor": "e3"}]}
