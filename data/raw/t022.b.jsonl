{"id": "t022-029", "text": "Spoke to Hemi on the phone. Biscuit is fine after the dental op, eating again. She was so relieved.", "spans": [{"id": "p1", "type": "PERSON", "text": "Hemi", "pronoun": "she"}, {"id": "f1", "type": "FACT", "text": "Biscuit", "owner": "p1", "fact_type": "pet"}, {"id": "e1", "type": "EVENT", "text": "dental op", "owner": "p1", "event_type": "medical", "followup": "check_in"}, {"id": "f2", "type": "FACT", "text": "relieved", "owner": "p1", "fact_type": "feeling"}]}
