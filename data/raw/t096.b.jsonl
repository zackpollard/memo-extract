{"id": "t096-019", "text": "Spoke to Tendai on the phone. Her brother Lwazi just got into the national rugby sevens squad. She's thrilled and a bit worried about his knee.", "spans": [{"id": "p1", "type": "PERSON", "text": "Tendai", "pronoun": "she"}, {"id": "f1", "type": "FACT", "text": "brother", "owner": "p2", "fact_type": "relationship"}, {"id": "p2", "type": "PERSON", "text": "Lwazi", "owner": "p1", "pronoun": "he"}, {"id": "e1", "type": "EVENT", "text": "got into the national rugby sevens squad", "owner": "p2", "event_type": "other", "followup": "congratulate"}, {"id": "f2", "type": "FACT", "text": "thrilled", "owner": "p1", "fact_type": "feeling"}, {"id": "f3", "type": "FACT", "text": "a bit worried about his knee", "owner": "p1", "fact_type": "feeling"}]}
