{"id": "t096-009", "text": "Talked to Ximena after book club. She's halfway through the Wolf Hall trilogy and loves anything set in the Tudor period. Her husband Tunde can't stand historical fiction, which she finds hilarious.", "spans": [{"id": "p1", "type": "PERSON", "text": "Ximena", "pronoun": "she"}, {"id": "d1", "type": "DATE", "text": "after book club"}, {"id": "i1", "type": "INTEREST", "text": "Wolf Hall trilogy", "owner": "p1"}, {"id": "i2", "type": "INTEREST", "text": "anything set in the Tudor period", "owner": "p1"}, {"id": "f1", "type": "FACT", "text": "husband", "owner": "p2", "fact_type": "relationship"}, {"id": "p2", "type": "PERSON", "text": "Tunde", "owner": "p1", "pronoun": "unknown"}, {"id": "f2", "type": "FACT", "text": "can't stand historical fiction", "owner": "p2", "fact_type": "dislike"}, {"id": "f3", "type": "FACT", "text": "finds hilarious", "owner": "p1", "fact_type": "feeling"}]}
