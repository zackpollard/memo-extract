{"id": "t017-058", "text": "Isaac - had the stag do last wkend, all went fine apparently. ask him for photos", "spans": [{"id": "p1", "type": "PERSON", "text": "Isaac", "pronoun": "he"}, {"id": "e1", "type": "EVENT", "text": "stag do", "event_type": "wedding", "followup": "ask_outcome", "owner": "p1"}, {"id": "d1", "type": "DATE", "text": "last wkend", "anchor": "e1"}, {"id": "a1", "type": "ACTION", "text": "ask him for photos", "action_type": "other", "timing": "after", "owner": "p1", "anchor": "e1"}]}
