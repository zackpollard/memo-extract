{"id": "t017-060", "text": "Oscar - battle of the bands 9 May @ the Wedgewood Rooms. drummer quit last wk, scrambling. text him Weds to see if he found someone, if not offer my mate Ali. also his gf Aditi's choir thing is the same night - double booked, she's not happy. he's promised to go to her next one 23rd. hmm", "spans": [{"id": "p1", "type": "PERSON", "text": "Oscar", "pronoun": "he"}, {"id": "e1", "type": "EVENT", "text": "battle of the bands", "owner": "p1", "event_type": "performance", "followup": "check_in"}, {"id": "d1", "type": "DATE", "text": "9 May", "anchor": "e1"}, {"id": "r1", "type": "RELATION", "text": "drummer", "owner": "p1"}, {"id": "e2", "type": "EVENT", "text": "quit", "owner": "p1", "event_type": "other", "followup": "check_in"}, {"id": "d2", "type": "DATE", "text": "last wk", "anchor": "e2"}, {"id": "f1", "type": "FACT", "text": "scrambling", "owner": "p1", "fact_type": "feeling"}, {"id": "a1", "type": "ACTION", "text": "text him", "owner": "p1", "anchor": "e1", "action_type": "ask_outcome", "timing": "before"}, {"id": "d3", "type": "DATE", "text": "Weds", "anchor": "a1"}, {"id": "a2", "type": "ACTION", "text": "offer my mate Ali", "owner": "p1", "anchor": "e1", "action_type": "other", "timing": "before"}, {"id": "f2", "type": "FACT", "text": "mate", "owner": "p2", "fact_type": "relationship"}, {"id": "p2", "type": "PERSON", "text": "Ali", "pronoun": "unknown"}, {"id": "f3", "type": "FACT", "text": "gf", "owner": "p3", "fact_type": "relationship"}, {"id": "p3", "type": "PERSON", "text": "Aditi", "owner": "p1", "pronoun": "she"}, {"id": "e3", "type": "EVENT", "text": "choir thing", "owner": "p3", "event_type": "performance", "followup": "ask_outcome"}, {"id": "d4", "type": "DATE", "text": "the same night", "anchor": "e3"}, {"id": "f4", "type": "FACT", "text": "not happy", "owner": "p3", "fact_type": "feeling"}, {"id": "e4", "type": "EVENT", "text": "next one", "owner": "p3", "event_type": "performance", "followup": "ask_outcome"}, {"id": "d5", "type": "DATE", "text": "23rd", "anchor": "e4"}]}
