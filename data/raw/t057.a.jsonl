{"id": "t057-047", "text": "Suzanne said her husband just started a new job at a solar company and absolutely loves it. Their kids are thrilled he's not working weekends anymore.", "spans": [{"id": "p1", "type": "PERSON", "text": "Suzanne", "pronoun": "she"}, {"id": "r1", "type": "RELATION", "text": "husband", "owner": "p1"}, {"id": "e1", "type": "EVENT", "text": "new job at a solar company", "owner": "r1", "event_type": "job", "followup": "ask_outcome"}, {"id": "f1", "type": "FACT", "text": "loves it", "owner": "r1", "fact_type": "feeling"}, {"id": "r2", "type": "RELATION", "text": "kids", "owner": "p1"}, {"id": "f2", "type": "FACT", "text": "thrilled", "owner": "r2", "fact_type": "feeling"}, {"id": "f3", "type": "FACT", "text": "not working weekends", "owner": "r1", "fact_type": "job"}]}
