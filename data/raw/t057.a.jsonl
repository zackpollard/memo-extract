{"id": "t057-030", "text": "Esme said her sister Noor is expecting in March. Their parents don't know yet so keep it quiet.", "spans": [{"id": "p1", "type": "PERSON", "text": "Esme", "pronoun": "she"}, {"id": "f1", "type": "FACT", "text": "sister", "owner": "p2", "fact_type": "relationship"}, {"id": "p2", "type": "PERSON", "text": "Noor", "owner": "p1", "pronoun": "unknown"}, {"id": "e1", "type": "EVENT", "text": "expecting", "owner": "p2", "event_type": "baby", "followup": "congratulate"}, {"id": "d1", "type": "DATE", "text": "in March", "anchor": "e1"}, {"id": "r1", "type": "RELATION", "text": "parents", "owner": "p1"}]}
