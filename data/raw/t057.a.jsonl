{"id": "t057-042", "text": "Zofia's cat Pierogi went missing on Monday night. Still no sign of him and she's devastated. I'll check in with her tomorrow evening.", "spans": [{"id": "p1", "type": "PERSON", "text": "Zofia", "pronoun": "she"}, {"id": "f1", "type": "FACT", "text": "cat Pierogi", "owner": "p1", "fact_type": "pet"}, {"id": "e1", "type": "EVENT", "text": "went missing", "owner": "p1", "event_type": "other", "followup": "check_in"}, {"id": "d1", "type": "DATE", "text": "Monday night", "anchor": "e1"}, {"id": "f2", "type": "FACT", "text": "devastated", "owner": "p1", "fact_type": "feeling"}, {"id": "d2", "type": "DATE", "text": "tomorrow evening"}]}
