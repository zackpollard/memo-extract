{"id": "t006-034", "text": "Phoebe and Sadia are both doing the half marathon on 4/27. Phoebe's aiming for under two hours, Sadia just wants to finish.", "spans": [{"id": "p1", "type": "PERSON", "text": "Phoebe", "pronoun": "unknown"}, {"id": "p2", "type": "PERSON", "text": "Sadia", "pronoun": "unknown"}, {"id": "e1", "type": "EVENT", "text": "half marathon", "owner": "p1", "event_type": "performance", "followup": "ask_outcome"}, {"id": "d1", "type": "DATE", "text": "4/27", "anchor": "e1"}, {"id": "p3", "type": "PERSON", "text": "Phoebe", "pronoun": "unknown"}, {"id": "p4", "type": "PERSON", "text": "Sadia", "pronoun": "unknown"}]}
