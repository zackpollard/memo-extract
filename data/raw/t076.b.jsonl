{"id": "t076-001", "text": "Noah flies to Lisbon on Friday for a week. He's never been and wants restaurant tips, so remind me to send him that list from my trip.", "spans": [{"id": "p1", "type": "PERSON", "text": "Noah", "pronoun": "he"}, {"id": "e1", "type": "EVENT", "text": "flies to Lisbon", "owner": "p1", "event_type": "travel", "followup": "ask_outcome"}, {"id": "d1", "type": "DATE", "text": "Friday", "anchor": "e1"}, {"id": "d2", "type": "DATE", "text": "a week", "anchor": "e1"}, {"id": "a1", "type": "ACTION", "text": "send him that list from my trip", "owner": "p1", "anchor": "e1", "action_type": "send", "timing": "before"}]}
