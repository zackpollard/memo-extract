{"id": "t128-054", "text": "Finn and Rachel's wedding - Sat 18th @ 2pm, church then barn in the Cotswolds. I'm doing the readings. suit fitting Weds after work. hotel booked Fri + Sat night. they've asked for no gifts but honeymoon fund - Bali. Rachel's gran flying in from Dublin the Thurs before, she's 92. bring a card + get some cash out the day before", "spans": [{"id": "p1", "type": "PERSON", "text": "Finn", "pronoun": "unknown"}, {"id": "p2", "type": "PERSON", "text": "Rachel", "pronoun": "unknown"}, {"id": "e1", "type": "EVENT", "text": "wedding", "event_type": "wedding", "followup": "none", "owner": "p1"}, {"id": "d1", "type": "DATE", "text": "Sat 18th @ 2pm", "anchor": "e1"}, {"id": "e2", "type": "EVENT", "text": "suit fitting", "event_type": "other", "followup": "none"}, {"id": "d2", "type": "DATE", "text": "Weds after work", "anchor": "e2"}, {"id": "d3", "type": "DATE", "text": "Fri + Sat night"}, {"id": "f1", "type": "FACT", "text": "no gifts but honeymoon fund", "fact_type": "other", "owner": "p1"}, {"id": "p3", "type": "PERSON", "text": "Rachel", "pronoun": "unknown"}, {"id": "r1", "type": "RELATION", "text": "gran", "owner": "p2"}, {"id": "e3", "type": "EVENT", "text": "flying in from Dublin", "event_type": "travel", "followup": "ask_outcome", "owner": "r1"}, {"id": "d4", "type": "DATE", "text": "the Thurs before", "anchor": "e3"}, {"id": "f2", "type": "FACT", "text": "92", "fact_type": "other", "owner": "r1"}, {"id": "a1", "type": "ACTION", "text": "bring a card", "action_type": "gift", "timing": "on", "owner": "p1", "anchor": "e1"}, {"id": "a2", "type": "ACTION", "text": "get some cash out", "action_type": "other", "timing": "before", "owner": "p1", "anchor": "e1"}, {"id": "d5", "type": "DATE", "text": "the day before", "anchor": "a2"}]}
