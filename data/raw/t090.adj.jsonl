{"id": "t090-037", "text": "Uncle Gareth's 60th is in a fortnight, Mum wants us all there. Need to get him something whisky related", "spans": [{"id": "p1", "type": "PERSON", "text": "Uncle Gareth", "pronoun": "he"}, {"id": "e1", "type": "EVENT", "text": "60th", "event_type": "birthday", "followup": "none", "owner": "p1"}, {"id": "d1", "type": "DATE", "text": "in a fortnight", "anchor": "e1"}, {"id": "r1", "type": "RELATION", "text": "Mum"}, {"id": "a1", "type": "ACTION", "text": "get him something whisky related", "action_type": "gift", "timing": "before", "owner": "p1", "anchor": "e1"}]}
