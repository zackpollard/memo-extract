{"id": "t090-044", "text": "Aisha's back from Lagos, her grandma's funeral was last Saturday. She's back at work tomorrow but said she's not really okay. Bring her a coffee and see how she's doing", "spans": [{"id": "p1", "type": "PERSON", "text": "Aisha", "pronoun": "she"}, {"id": "e1", "type": "EVENT", "text": "back from Lagos", "event_type": "travel", "followup": "check_in", "owner": "p1"}, {"id": "r1", "type": "RELATION", "text": "grandma", "owner": "p1"}, {"id": "e2", "type": "EVENT", "text": "funeral", "event_type": "loss", "followup": "check_in", "owner": "p1"}, {"id": "d1", "type": "DATE", "text": "last Saturday", "anchor": "e2"}, {"id": "e3", "type": "EVENT", "text": "back at work", "event_type": "job", "followup": "check_in", "owner": "p1"}, {"id": "d2", "type": "DATE", "text": "tomorrow", "anchor": "e3"}, {"id": "f1", "type": "FACT", "text": "not really okay", "fact_type": "feeling", "owner": "p1"}, {"id": "a1", "type": "ACTION", "text": "Bring her a coffee and see how she's doing", "action_type": "check_in", "timing": "on", "owner": "p1", "anchor": "e3"}]}
