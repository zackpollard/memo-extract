{"id": "t069-020", "text": "Mila's band are playing Glastonbury on the Friday this year. Small stage, but still! Her brother Ethan is driving the van down.", "spans": [{"id": "p1", "type": "PERSON", "text": "Mila", "pronoun": "she"}, {"id": "e1", "type": "EVENT", "text": "playing Glastonbury", "owner": "p1", "event_type": "performance", "followup": "ask_outcome"}, {"id": "d1", "type": "DATE", "text": "the Friday this year", "anchor": "e1"}, {"id": "f1", "type": "FACT", "text": "brother", "owner": "p2", "fact_type": "relationship"}, {"id": "p2", "type": "PERSON", "text": "Ethan", "owner": "p1", "pronoun": "unknown"}]}
