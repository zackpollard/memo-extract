{"id": "t069-016", "text": "Ciara's dog Biscuit has to have an operation on his knee on Monday at 2pm. She's worried sick about the cost and the anaesthetic. Text her on Monday evening to see how he's doing.", "spans": [{"id": "p1", "type": "PERSON", "text": "Ciara", "pronoun": "she"}, {"id": "f1", "type": "FACT", "text": "dog Biscuit", "owner": "p1", "fact_type": "pet"}, {"id": "e1", "type": "EVENT", "text": "operation on his knee", "owner": "p1", "event_type": "medical", "followup": "check_in"}, {"id": "d1", "type": "DATE", "text": "Monday at 2pm", "anchor": "e1"}, {"id": "f2", "type": "FACT", "text": "worried sick", "owner": "p1", "fact_type": "feeling"}, {"id": "a1", "type": "ACTION", "text": "Text her", "owner": "p1", "anchor": "e1", "action_type": "check_in", "timing": "on"}, {"id": "d2", "type": "DATE", "text": "Monday evening", "anchor": "a1"}]}
