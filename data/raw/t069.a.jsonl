{"id": "t069-001", "text": "Fiona flies to Lisbon on 14 May at 6am. She's never done a flight on her own before and sounded quite anxious about it. Remind me to text her the night before.", "spans": [{"id": "p1", "type": "PERSON", "text": "Fiona", "pronoun": "she"}, {"id": "e1", "type": "EVENT", "text": "flies to Lisbon", "owner": "p1", "event_type": "travel", "followup": "ask_outcome"}, {"id": "d1", "type": "DATE", "text": "14 May at 6am", "anchor": "e1"}, {"id": "f1", "type": "FACT", "text": "quite anxious", "owner": "p1", "fact_type": "feeling"}, {"id": "a1", "type": "ACTION", "text": "text her", "owner": "p1", "anchor": "e1", "action_type": "message", "timing": "before"}, {"id": "d2", "type": "DATE", "text": "the night before", "anchor": "a1"}]}
