{"id": "t141-055", "text": "Leah's daughter has chicken pox so the birthday party Saturday is cancelled. Moving it to the 28th maybe.", "spans": [{"id": "p1", "type": "PERSON", "text": "Leah", "pronoun": "unknown"}, {"id": "r1", "type": "RELATION", "text": "daughter", "owner": "p1"}, {"id": "e1", "type": "EVENT", "text": "chicken pox", "event_type": "medical", "followup": "check_in", "owner": "r1"}, {"id": "e2", "type": "EVENT", "text": "birthday party", "event_type": "party", "followup": "ask_outcome", "owner": "r1"}, {"id": "d1", "type": "DATE", "text": "Saturday"}, {"id": "d2", "type": "DATE", "text": "to the 28th", "anchor": "e2"}]}
