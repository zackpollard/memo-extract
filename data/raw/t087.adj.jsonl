{"id": "t087-030", "text": "alana says her mum's dementia is getting worse, she didnt recognise alana on sunday which really shook her. they're looking at care homes, viewing two next sat morning, one in harrogate and one closer to her brother Tomás. she's really struggling w/ it all and feels guilty. need to check in more often, maybe a call sat afternoon after the viewings", "spans": [{"id": "p1", "type": "PERSON", "text": "alana", "pronoun": "she"}, {"id": "r1", "type": "RELATION", "text": "mum", "owner": "p1"}, {"id": "f1", "type": "FACT", "text": "dementia", "owner": "r1", "fact_type": "health"}, {"id": "p2", "type": "PERSON", "text": "alana", "pronoun": "she"}, {"id": "d1", "type": "DATE", "text": "sunday"}, {"id": "f2", "type": "FACT", "text": "shook", "owner": "p1", "fact_type": "feeling"}, {"id": "e1", "type": "EVENT", "text": "viewing", "owner": "p1", "event_type": "move", "followup": "check_in"}, {"id": "d2", "type": "DATE", "text": "next sat morning", "anchor": "e1"}, {"id": "f3", "type": "FACT", "text": "brother", "owner": "p3", "fact_type": "relationship"}, {"id": "p3", "type": "PERSON", "text": "Tomás", "owner": "p1", "pronoun": "unknown"}, {"id": "f4", "type": "FACT", "text": "struggling", "owner": "p1", "fact_type": "feeling"}, {"id": "f5", "type": "FACT", "text": "guilty", "owner": "p1", "fact_type": "feeling"}, {"id": "a1", "type": "ACTION", "text": "check in more often", "owner": "p1", "action_type": "check_in", "timing": "unspecified"}, {"id": "a2", "type": "ACTION", "text": "a call", "owner": "p1", "anchor": "e1", "action_type": "call", "timing": "after"}, {"id": "d3", "type": "DATE", "text": "sat afternoon after the viewings", "anchor": "a2"}]}
