{"id": "t005-054", "text": "Coffee with Santiago. He's struggling a bit since the redundancy, applying for loads but nothing yet. Take him for lunch next week, my treat", "spans": [{"id": "p1", "type": "PERSON", "text": "Santiago", "pronoun": "he"}, {"id": "f1", "type": "FACT", "text": "struggling a bit", "owner": "p1", "fact_type": "feeling"}, {"id": "e1", "type": "EVENT", "text": "redundancy", "owner": "p1", "event_type": "loss", "followup": "check_in"}, {"id": "a1", "type": "ACTION", "text": "Take him for lunch", "owner": "p1", "anchor": "e1", "action_type": "meet", "timing": "after"}, {"id": "d1", "type": "DATE", "text": "next week", "anchor": "a1"}]}
