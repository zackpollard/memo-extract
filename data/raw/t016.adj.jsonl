{"id": "t016-044", "text": "Bilal's sister Hana had her baby last week, baby boy, 3 weeks early but both doing well. Bilal is an uncle for the first time and won't stop showing photos", "spans": [{"id": "p1", "type": "PERSON", "text": "Bilal", "pronoun": "unknown"}, {"id": "f1", "type": "FACT", "text": "sister", "owner": "p2", "fact_type": "relationship"}, {"id": "p2", "type": "PERSON", "text": "Hana", "owner": "p1", "pronoun": "she"}, {"id": "e1", "type": "EVENT", "text": "had her baby", "owner": "p2", "event_type": "baby", "followup": "congratulate"}, {"id": "d1", "type": "DATE", "text": "last week", "anchor": "e1"}, {"id": "r1", "type": "RELATION", "text": "baby boy", "owner": "p2"}, {"id": "f2", "type": "FACT", "text": "doing well", "owner": "p2", "fact_type": "feeling"}, {"id": "p3", "type": "PERSON", "text": "Bilal", "pronoun": "unknown"}, {"id": "f3", "type": "FACT", "text": "uncle", "owner": "p1", "fact_type": "relationship"}]}
