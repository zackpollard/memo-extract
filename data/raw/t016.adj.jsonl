{"id": "t016-009", "text": "Bilal hates cats lol, keep that in mind when he comes round", "spans": [{"id": "p1", "type": "PERSON", "text": "Bilal", "pronoun": "he"}, {"id": "f1", "type": "FACT", "text": "hates cats", "owner": "p1", "fact_type": "dislike"}, {"id": "a1", "type": "ACTION", "text": "keep that in mind", "owner": "p1", "anchor": "e1", "action_type": "other", "timing": "on"}, {"id": "e1", "type": "EVENT", "text": "comes round", "owner": "p1", "event_type": "party", "followup": "none"}]}
