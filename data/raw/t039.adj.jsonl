{"id": "t039-060", "text": "meera's grandma had her pacemaker fitted on 1st oct, recovering well but meera says she's fed up of everyone fussing. then her uncle Sunil had his heart scan on the 14th and needs a follow up appt early dec. honestly that family has had a year. ring meera next wk and check how everyone is", "spans": [{"id": "p1", "type": "PERSON", "text": "meera", "pronoun": "she"}, {"id": "r1", "type": "RELATION", "text": "grandma", "owner": "p1"}, {"id": "e1", "type": "EVENT", "text": "pacemaker fitted", "event_type": "medical", "followup": "check_in", "owner": "r1"}, {"id": "d1", "type": "DATE", "text": "1st oct", "anchor": "e1"}, {"id": "p2", "type": "PERSON", "text": "meera", "pronoun": "she"}, {"id": "f1", "type": "FACT", "text": "fed up of everyone fussing", "fact_type": "feeling", "owner": "r1"}, {"id": "f2", "type": "FACT", "text": "uncle", "fact_type": "relationship", "owner": "p3"}, {"id": "p3", "type": "PERSON", "text": "Sunil", "pronoun": "he", "owner": "p1"}, {"id": "e2", "type": "EVENT", "text": "heart scan", "event_type": "medical", "followup": "check_in", "owner": "p3"}, {"id": "d2", "type": "DATE", "text": "the 14th", "anchor": "e2"}, {"id": "e3", "type": "EVENT", "text": "follow up appt", "event_type": "medical", "followup": "check_in", "owner": "p3"}, {"id": "d3", "type": "DATE", "text": "early dec", "anchor": "e3"}, {"id": "a1", "type": "ACTION", "text": "ring meera", "action_type": "call", "timing": "after", "owner": "p1", "anchor": "e1"}, {"id": "p4", "type": "PERSON", "text": "meera", "pronoun": "she"}, {"id": "d4", "type": "DATE", "text": "next wk", "anchor": "a1"}, {"id": "a2", "type": "ACTION", "text": "check how everyone is", "action_type": "check_in", "timing": "after", "owner": "p1", "anchor": "e1"}]}
