{"id": "x005-019", "text": "uncle Abebe has his hip op on 4th of march 2027. mum is taking him in and I'm doing the drive back after. he's being v brave abt it but auntie says he's not sleeping", "spans": [{"id": "p1", "type": "PERSON", "text": "uncle Abebe", "pronoun": "he"}, {"id": "e1", "type": "EVENT", "text": "hip op", "owner": "p1", "event_type": "medical", "followup": "check_in"}, {"id": "d1", "type": "DATE", "text": "4th of march 2027", "anchor": "e1"}, {"id": "r1", "type": "RELATION", "text": "mum"}, {"id": "d2", "type": "DATE", "text": "after", "anchor": "e1"}, {"id": "f1", "type": "FACT", "text": "brave", "owner": "p1", "fact_type": "feeling"}, {"id": "r2", "type": "RELATION", "text": "auntie"}, {"id": "f2", "type": "FACT", "text": "not sleeping", "owner": "p1", "fact_type": "feeling"}]}
