{"id": "t079-024", "text": "Carmen - redundancy consultation 5th Dec. 1 of 4 roles going. she thinks it's her. check in after", "spans": [{"id": "p1", "type": "PERSON", "text": "Carmen", "pronoun": "she"}, {"id": "e1", "type": "EVENT", "text": "redundancy consultation", "owner": "p1", "event_type": "job", "followup": "check_in"}, {"id": "d1", "type": "DATE", "text": "5th Dec", "anchor": "e1"}, {"id": "a1", "type": "ACTION", "text": "check in", "owner": "p1", "anchor": "e1", "action_type": "check_in", "timing": "after"}, {"id": "d2", "type": "DATE", "text": "after", "anchor": "a1"}]}
