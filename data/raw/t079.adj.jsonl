{"id": "t079-043", "text": "Mariam's grandad passed on the 4th. funeral was yesterday, she went w/ her sisters. she's ok-ish. message her tmrw", "spans": [{"id": "p1", "type": "PERSON", "text": "Mariam", "pronoun": "she"}, {"id": "r1", "type": "RELATION", "text": "grandad", "owner": "p1"}, {"id": "e1", "type": "EVENT", "text": "passed", "event_type": "loss", "followup": "check_in", "owner": "p1"}, {"id": "d1", "type": "DATE", "text": "the 4th", "anchor": "e1"}, {"id": "e2", "type": "EVENT", "text": "funeral", "event_type": "loss", "followup": "check_in", "owner": "p1"}, {"id": "d2", "type": "DATE", "text": "yesterday", "anchor": "e2"}, {"id": "r2", "type": "RELATION", "text": "sisters", "owner": "p1"}, {"id": "f1", "type": "FACT", "text": "ok-ish", "fact_type": "feeling", "owner": "p1"}, {"id": "a1", "type": "ACTION", "text": "message her", "action_type": "message", "timing": "after", "owner": "p1", "anchor": "e2"}, {"id": "d3", "type": "DATE", "text": "tmrw", "anchor": "a1"}]}
