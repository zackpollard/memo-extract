{"id": "t044-022", "text": "jorge plays bass, loves old funk records. birthday coming up - he mentioned wanting the new vulfpeck vinyl", "spans": [{"id": "p1", "type": "PERSON", "text": "jorge", "pronoun": "he"}, {"id": "i1", "type": "INTEREST", "text": "bass", "owner": "p1"}, {"id": "i2", "type": "INTEREST", "text": "old funk records", "owner": "p1"}, {"id": "e1", "type": "EVENT", "text": "birthday", "event_type": "birthday", "followup": "gift", "owner": "p1"}, {"id": "d1", "type": "DATE", "text": "coming up", "anchor": "e1"}, {"id": "f1", "type": "FACT", "text": "wanting the new vulfpeck vinyl", "fact_type": "other", "owner": "p1"}]}
