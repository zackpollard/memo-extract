{"id": "t155-053", "text": "Georgia and Layla are moving in together on October 31st. Georgia's cat and Layla's dog have never met, so wish them luck.", "spans": [{"id": "p1", "type": "PERSON", "text": "Georgia", "pronoun": "unknown"}, {"id": "p2", "type": "PERSON", "text": "Layla", "pronoun": "unknown"}, {"id": "e1", "type": "EVENT", "text": "moving in together", "owner": "p1", "event_type": "move", "followup": "ask_outcome"}, {"id": "d1", "type": "DATE", "text": "October 31st", "anchor": "e1"}, {"id": "p3", "type": "PERSON", "text": "Georgia", "pronoun": "unknown"}, {"id": "f1", "type": "FACT", "text": "cat", "owner": "p1", "fact_type": "pet"}, {"id": "p4", "type": "PERSON", "text": "Layla", "pronoun": "unknown"}, {"id": "f2", "type": "FACT", "text": "dog", "owner": "p2", "fact_type": "pet"}]}
