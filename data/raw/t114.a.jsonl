{"id": "t114-046", "text": "Jorge's daughter's graduation is 10th July in Glasgow, the whole family's going up. He's driving up the day before with the dog, his wife's flying with her mum because she can't do eight hours in a car with her hip. Daughter's got a first in marine biology and already has a job lined up in Aberdeen starting September. He's very proud.", "spans": [{"id": "p1", "type": "PERSON", "text": "Jorge", "pronoun": "he"}, {"id": "r1", "type": "RELATION", "text": "daughter", "owner": "p1"}, {"id": "e1", "type": "EVENT", "text": "graduation", "owner": "r1", "event_type": "school", "followup": "congratulate"}, {"id": "d1", "type": "DATE", "text": "10th July", "anchor": "e1"}, {"id": "d2", "type": "DATE", "text": "the day before"}, {"id": "f1", "type": "FACT", "text": "dog", "owner": "p1", "fact_type": "pet"}, {"id": "r2", "type": "RELATION", "text": "wife", "owner": "p1"}, {"id": "r3", "type": "RELATION", "text": "mum", "owner": "r2"}, {"id": "f2", "type": "FACT", "text": "can't do eight hours in a car with her hip", "owner": "r2", "fact_type": "health"}, {"id": "r4", "type": "RELATION", "text": "Daughter", "owner": "p1"}, {"id": "f3", "type": "FACT", "text": "first in marine biology", "owner": "r1", "fact_type": "job"}, {"id": "e2", "type": "EVENT", "text": "job lined up in Aberdeen", "owner": "r1", "event_type": "job", "followup": "ask_outcome"}, {"id": "d3", "type": "DATE", "text": "September", "anchor": "e2"}, {"id": "f4", "type": "FACT", "text": "proud", "owner": "p1", "fact_type": "feeling"}]}
